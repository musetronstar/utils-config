#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: vmd [-p|--plain] [--stdout] file.md"
  exit 1
}

PLAIN=false
TO_STDOUT=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--plain)
      PLAIN=true
      shift
      ;;
    --stdout)
      TO_STDOUT=true
      shift
      ;;
    -h|--help)
      usage
      ;;
    -*)
      usage
      ;;
    *)
      break
      ;;
  esac
done

[[ $# -eq 1 ]] || usage
MD_FILE="$1"
[[ -f "$MD_FILE" ]] || { echo "Error: file not found: $MD_FILE" >&2; exit 1; }

TITLE="$(basename "$MD_FILE")"

render_md() {
  cmark-gfm \
    --extension table \
    --extension strikethrough \
    --extension autolink \
    --extension tasklist \
    --extension footnotes \
    --extension tagfilter \
    "$MD_FILE"
}

render() {
  if $PLAIN; then
    render_md
  else
    CSS_MD_LIGHT="https://cdn.jsdelivr.net/npm/github-markdown-css@latest/github-markdown.min.css"
    CSS_MD_DARK="https://cdn.jsdelivr.net/npm/github-markdown-css@latest/github-markdown-dark.min.css"
    CSS_HL_LIGHT="https://cdn.jsdelivr.net/npm/highlight.js@latest/styles/github.min.css"
    CSS_HL_DARK="https://cdn.jsdelivr.net/npm/highlight.js@latest/styles/github-dark.min.css"
    JS_HL="https://cdn.jsdelivr.net/npm/highlight.js@latest/highlight.min.js"

    cat <<EOF
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$TITLE</title>
<link rel="stylesheet" href="$CSS_MD_LIGHT" media="(prefers-color-scheme: light)">
<link rel="stylesheet" href="$CSS_MD_DARK"  media="(prefers-color-scheme: dark)">
<link rel="stylesheet" href="$CSS_HL_LIGHT" media="(prefers-color-scheme: light)">
<link rel="stylesheet" href="$CSS_HL_DARK"  media="(prefers-color-scheme: dark)">
<style>
  :root { color-scheme: light dark; }
  body {
    box-sizing: border-box;
    min-width: 200px;
    max-width: 980px;
    margin: 40px auto;
    padding: 0 16px 40px 16px;
  }
  img { max-width: 100%; height: auto; }
  pre { overflow-x: auto; }
  table { display: block; overflow-x: auto; white-space: nowrap; }
</style>
</head>
<body>
<article class="markdown-body">
$(render_md)
</article>
<script src="$JS_HL"></script>
<script>hljs.highlightAll();</script>
</body>
</html>
EOF
  fi
}

if $TO_STDOUT; then
  render
  exit 0
fi

HTML_FILE="$(mktemp --suffix=.html)"
render > "$HTML_FILE"

firefox --new-tab "file://$HTML_FILE" >/dev/null 2>&1 & disown
echo "Rendered to: $HTML_FILE"

